# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO (SERVIDOR)
# Copie estas variáveis para o painel de variáveis da sua plataforma (Railway/Coolify/Dokploy/etc)
# ==============================================================================

# --- BANCO DE DADOS (POSTGRESQL) ---
# Obrigatório: URL de conexão do PostgreSQL gerenciado ou container no servidor
DATABASE_URL="postgresql://usuario:senha@host:5432/nomedobanco?schema=public"
LOCAL_DB=0

# --- DOMÍNIO E AMBIENTE ---
NODE_ENV=production
# URL pública do site (com https)
SITE_URL="https://soubarbarotti.com.br"

# --- SEGURANÇA E ACESSO AO ADMIN ---
# Chave de 32+ caracteres para assinatura de cookies e tokens de sessão
SESSION_SECRET=""
# Hash scrypt da senha do painel /admin (gerado via: npm run senha -- "suasenha")
ADMIN_PASSWORD_HASH=""

# --- ARMAZENAMENTO DE MÍDIAS (STORAGE) ---
# Escolha 'local' (se tiver volume de disco persistente montado) ou 'r2' (Cloudflare R2 / S3)
STORAGE_DRIVER=local
STORAGE_DIR="./storage"
UPLOAD_TMP_DIR="./.data/uploads"
MEDIA_BASE_URL="/media"

# --- CLOUDFLARE R2 (Preencher apenas se STORAGE_DRIVER=r2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# MEDIA_BASE_URL="https://media.soubarbarotti.com.br"

# --- NOTIFICAÇÕES WHATSAPP VIA CALLMEBOT (OPCIONAL) ---
# Número só com dígitos (DDI + DDD + Número)
WHATSAPP_NOTIFY_PHONE=""
CALLMEBOT_APIKEY=""

# --- CONFIGURAÇÕES DO FFMPEG & UPLOADS (OPCIONAIS) ---
FFMPEG_PRESET="medium"
FFMPEG_THREADS="2"
MAX_VIDEO_MB="2048"
MAX_IMAGE_MB="30"
